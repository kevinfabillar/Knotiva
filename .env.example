# Knotiva environment variables. Copy to .env.local for local development (never commit it),
# and add the same names in Vercel → Project → Settings → Environment Variables.
# See PAYMENTS.md for where each value comes from.

# ---------- Browser (public; Vite exposes VITE_* to the client bundle) ----------
# Firebase console → Project settings → General → Your apps → Web app → SDK config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# The address shown in the "your link" preview (on localhost the dev server is shown instead).
VITE_SITE_URL=https://www.knotiva.my

# ---------- Server only (/api functions; SECRET, never prefix with VITE_) ----------
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON file on ONE line.
FIREBASE_SERVICE_ACCOUNT=
# The bucket photo URLs must come from (same value as VITE_FIREBASE_STORAGE_BUCKET).
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# PayMongo dashboard → Developers → API keys. sk_test_… for testing, sk_live_… for real payments.
PAYMONGO_SECRET_KEY=
# Printed by `node scripts/paymongo-webhook.mjs <url>` (whsk_…). One per mode (test/live).
PAYMONGO_WEBHOOK_SECRET=
# Where PayMongo sends couples back after paying (success_url / cancel_url). Default
# https://www.knotiva.my. Requests to a localhost dev server return to localhost instead.
SITE_URL=https://www.knotiva.my
