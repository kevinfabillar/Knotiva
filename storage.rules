rules_version = '2';

// Knotiva photo uploads. While a couple's order is pending, their browser may upload images
// (image/*, under 2 MB) to orders/{orderId}/. Guests see photos through the download URLs saved
// on the published site, which carry their own access token, so no public read rule is needed.
// The Firestore lookup needs the Storage service to be allowed to read Firestore: the Firebase CLI
// offers to grant this the first time you deploy these rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /orders/{orderId}/{fileName} {
      allow read: if false;
      allow delete: if false;
      allow create, update: if request.resource != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && fileName.matches('[A-Za-z0-9._-]{1,80}')
        && firestore.exists(/databases/(default)/documents/orders/$(orderId))
        && firestore.get(/databases/(default)/documents/orders/$(orderId)).data.status == 'pending';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
